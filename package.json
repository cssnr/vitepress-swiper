{
  "name": "@cssnr/vitepress-swiper",
  "version": "0.0.1",
  "description": "A VitePress Plugin to Easily add a SwiperJS Photo Gallery or Image Slideshow with Custom Options.",
  "keywords": [
    "vitepress-plugin",
    "vitepress",
    "plugin",
    "swiper",
    "swiperjs",
    "image",
    "gallery",
    "photo",
    "slideshow"
  ],
  "homepage": "https://vitepress-swiper.cssnr.com",
  "bugs": {
    "url": "https://github.com/cssnr/vitepress-swiper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cssnr/vitepress-swiper.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/cssnr"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Shane",
    "url": "https://cssnr.github.io/"
  },
  "exports": {
    ".": {
      "import": "./dist/VPSwiper.es.js",
      "require": "./dist/VPSwiper.umd.js",
      "types": "./dist/VPSwiper.vue.d.ts"
    },
    "./style.css": "./dist/VPSwiper.css"
  },
  "main": "dist/VPSwiper.umd.js",
  "module": "dist/VPSwiper.es.js",
  "types": "dist/VPSwiper.vue.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc",
    "docs": "npm run docs:dev",
    "docs:build": "vitepress build docs",
    "docs:deploy": "npm run get-contributors && npm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "get-contributors": "npx get-contributors cssnr/vitepress-swiper -f docs/.vitepress/contributors.json",
    "lint": "eslint src",
    "prepare": "npm run build",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "yamllint": "yamllint -c .github/yamllint.yaml ."
  },
  "devDependencies": {
    "@cssnr/vitepress-chat": "github:smashedr/vitepress-chat#0.2.0",
    "@cssnr/vitepress-plugin-contributors": "^0.2.0",
    "@cssnr/vitepress-plugin-copybutton": "^0.0.3",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  },
  "peerDependencies": {
    "swiper": ">=11.0.0",
    "vue": "^3.0.0"
  }
}
